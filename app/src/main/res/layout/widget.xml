<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/widget_bg" android:padding="10dp">
    <LinearLayout android:id="@+id/w_info" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/w_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/w_state" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#9AA0A6" android:textSize="12sp" android:maxLines="1"/>
    </LinearLayout>
    <TextView android:id="@+id/w_power" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="44dp" android:layout_marginStart="6dp" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:background="@drawable/widget_btn" android:textColor="#FFFFFF" android:textSize="14sp" android:text="전원"/>
    <TextView android:id="@+id/w_down" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="44dp" android:layout_marginStart="6dp" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:background="@drawable/widget_btn" android:textColor="#FFFFFF" android:textSize="14sp" android:text="−"/>
    <TextView android:id="@+id/w_up" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="44dp" android:layout_marginStart="6dp" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:background="@drawable/widget_btn" android:textColor="#FFFFFF" android:textSize="14sp" android:text="+"/>
    <TextView android:id="@+id/w_night" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="44dp" android:layout_marginStart="6dp" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:background="@drawable/widget_btn" android:textColor="#FFFFFF" android:textSize="14sp" android:text="야간"/>
</LinearLayout>
